<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test Framework -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- Mocking and Assertions -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />

    <!-- Roslyn and Code Analysis -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" ExcludeAssets="runtime" PrivateAssets="all">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Caching -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.1" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />

    <!-- Dependency Injection for integration tests -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Moq" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core Library -->
    <ProjectReference Include="..\src\RoslynMcpServer.Core\RoslynMcpServer.Core.csproj" />

    <!-- Full Version (42 tools) -->
    <ProjectReference Include="..\RoslynMcpServer\RoslynMcpServer.csproj" />

    <!-- Modular MCP Servers -->
    <ProjectReference Include="..\src\RoslynMcpServer.Navigation\RoslynMcpServer.Navigation.csproj" />
    <ProjectReference Include="..\src\RoslynMcpServer.Quality\RoslynMcpServer.Quality.csproj" />
    <ProjectReference Include="..\src\RoslynMcpServer.Security\RoslynMcpServer.Security.csproj" />
    <ProjectReference Include="..\src\RoslynMcpServer.Dependencies\RoslynMcpServer.Dependencies.csproj" />
    <ProjectReference Include="..\src\RoslynMcpServer.Refactoring\RoslynMcpServer.Refactoring.csproj" />
    <ProjectReference Include="..\src\RoslynMcpServer.Testing\RoslynMcpServer.Testing.csproj" />
    <ProjectReference Include="..\src\RoslynMcpServer.Metrics\RoslynMcpServer.Metrics.csproj" />
    <ProjectReference Include="..\src\RoslynMcpServer.Advanced\RoslynMcpServer.Advanced.csproj" />
  </ItemGroup>

</Project>