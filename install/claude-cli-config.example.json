{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-config.json",
  "mcpServers": {
    "roslyn-navigation": {
      "command": "dotnet",
      "args": ["run", "--project", "/path/to/RoslynCSMCP/src/RoslynMcpServer.Navigation", "-c", "Release"],
      "env": { "DOTNET_ENVIRONMENT": "Production" }
    },
    "roslyn-quality": {
      "command": "dotnet",
      "args": ["run", "--project", "/path/to/RoslynCSMCP/src/RoslynMcpServer.Quality", "-c", "Release"],
      "env": { "DOTNET_ENVIRONMENT": "Production" }
    },
    "roslyn-security": {
      "command": "dotnet",
      "args": ["run", "--project", "/path/to/RoslynCSMCP/src/RoslynMcpServer.Security", "-c", "Release"],
      "env": { "DOTNET_ENVIRONMENT": "Production" }
    }
  }
}
