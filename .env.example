# =============================================================================
# RoslynCSMCP Docker Environment Configuration
# =============================================================================
# Copy this file to .env and update the paths to match your system
# Usage: docker-compose --env-file .env up -d
# =============================================================================

# =============================================================================
# Volume Paths
# =============================================================================

# Path to your C# solution directory (will be mounted to /workspace in container)
# This should be the directory containing your .sln file
# The container needs read access to analyze your code

# Windows Example:
# WORKSPACE_PATH=C:/Projects/MySolution

# macOS Example:
# WORKSPACE_PATH=/Users/username/Projects/MySolution

# Linux Example:
# WORKSPACE_PATH=/home/username/projects/MySolution

WORKSPACE_PATH=./workspace

# Path to store log files (will be mounted to /logs in container)
# The container needs read-write access to create log files

# Windows Example:
# LOGS_PATH=C:/Logs/RoslynMCP

# macOS Example:
# LOGS_PATH=/Users/username/Logs/RoslynMCP

# Linux Example:
# LOGS_PATH=/var/log/roslynmcp

LOGS_PATH=./logs

# =============================================================================
# Optional: Additional Environment Variables
# =============================================================================
# These can also be set in docker-compose.yml

# .NET Environment (Production or Development)
# DOTNET_ENVIRONMENT=Production

# Logging Level (Trace, Debug, Information, Warning, Error, Critical)
# LOG_LEVEL=Information

# Timezone (optional)
# TZ=America/New_York

# =============================================================================
# Notes
# =============================================================================
#
# 1. Use forward slashes (/) for paths, even on Windows
#    Good: C:/Projects/MySolution
#    Bad:  C:\Projects\MySolution
#
# 2. Avoid spaces in paths or use quotes:
#    Good: "C:/My Projects/Solution"
#    Good: C:/MyProjects/Solution
#
# 3. Ensure directories exist before starting the container:
#    mkdir -p /path/to/logs
#
# 4. Read-only workspace is recommended for safety:
#    In docker-compose.yml: ${WORKSPACE_PATH}:/workspace:ro
#
# 5. Logs directory must be writable:
#    In docker-compose.yml: ${LOGS_PATH}:/logs:rw
#
# =============================================================================
